import os
import zipfile
import numpy as np
import streamlit as st
import tensorflow as tf
from PIL import Image

st.set_page_config(page_title="Skin Cancer Detection (HAM10000)", layout="centered")

st.title("Skin Cancer Detection (HAM10000)")
st.write("Upload a dermatoscopic skin lesion image to classify it across the 7 HAM10000 diagnostic categories.")

MODEL_PATH = "skin_lesion_model.keras"

# HAM10000 standard 7 classes (update order if your LabelEncoder/generator used a different mapping)
CLASS_NAMES = [
    "Actinic keratoses (akiec)",
    "Basal cell carcinoma (bcc)",
    "Benign keratosis-like lesions (bkl)",
    "Dermatofibroma (df)",
    "Melanoma (mel)",
    "Melanocytic nevi (nv)",
    "Vascular lesions (vasc)"
]

@st.cache_resource
def load_trained_model(path):
    if not os.path.exists(path):
        raise FileNotFoundError(f"Model file '{path}' not found in repository root.")
    if not zipfile.is_zipfile(path):
        raise ValueError(
            f"'{path}' is not a valid Keras zip archive (size: {os.path.getsize(path)} bytes). "
            "If you used Git LFS, re-upload the raw .keras file (<100MB) or download it from external storage."
        )
    return tf.keras.models.load_model(path)

try:
    model = load_trained_model(MODEL_PATH)
except Exception as e:
    st.error(f"Failed to load model: {e}")
    st.stop()

uploaded_file = st.file_uploader("Choose a skin lesion image...", type=["jpg", "jpeg", "png"])

if uploaded_file is not None:
    image = Image.open(uploaded_file).convert("RGB")
    st.image(image, caption="Uploaded Image", width="stretch")

    # Dynamically match model's expected input size (e.g., 224x224 or 28x28)
    input_shape = model.input_shape[1:3]
    img_resized = image.resize(input_shape)
    img_array = np.array(img_resized, dtype=np.float32)

    # Adjust normalization if your training used /255.0 vs model-specific preprocess_input
    img_array = img_array / 255.0
    img_batch = np.expand_dims(img_array, axis=0)

    with st.spinner("Analyzing image..."):
        predictions = model.predict(img_batch)[0]
        predicted_idx = int(np.argmax(predictions))
        confidence = float(predictions[predicted_idx]) * 100

    st.subheader(f"Prediction: {CLASS_NAMES[predicted_idx]}")
    st.write(f"**Confidence:** {confidence:.2f}%")

    # Display probability breakdown
    st.write("### Class Probabilities")
    prob_dict = {CLASS_NAMES[i]: float(predictions[i]) for i in range(len(CLASS_NAMES))}
    st.bar_chart(prob_dict)
